rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // 헬퍼 함수들
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    function isAuthorOrAdmin(authorUid) {
      return isAuthenticated() && 
             (request.auth.uid == authorUid || isAdmin());
    }
    
    function isAdminSDK() {
      return request.auth == null;
    }
    
    // ============================================
    // 사용자 정보
    // ============================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow read, write: if isAdminSDK();
    }
    
    // ============================================
    // 게시글 (posts) - 스트레스 해소 포함
    // ============================================
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdminSDK();
      allow update: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isAdmin())
                       || isAdminSDK();
      allow delete: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isAdmin())
                       || isAdminSDK();
    }
    
    // ============================================
    // 댓글 (서브컬렉션)
    // ============================================
    match /posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdminSDK();
      allow update: if isAuthenticated() || isAdminSDK();
      allow delete: if isAuthenticated() || isAdminSDK();
    }
    
    // ============================================
    // 댓글 (루트 컬렉션)
    // ============================================
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdminSDK();
      allow update: if isAuthenticated() || isAdminSDK();
      allow delete: if isAuthenticated() || isAdminSDK();
    }
    
    // ============================================
    // 밸런스 게임
    // ============================================
    match /balance_votes/{voteId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() || isAdminSDK();
    }
    
    match /user_balance_votes/{voteId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() || isAdminSDK();
    }
    
    match /balance_comments/{commentId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() || isAdminSDK();
    }
    
    // ============================================
    // 투표 (decision_polls)
    // ============================================
    match /decision_polls/{pollId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdminSDK();
      allow update: if isAuthenticated() || isAdminSDK();
      allow delete: if isAuthenticated() || isAdminSDK();
      
      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() || isAdminSDK();
      }
      
      match /votes/{userId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // ============================================
    // 메시지
    // ============================================
    match /messages/{messageId} {
      allow read: if isAuthenticated() && 
        (resource.data.senderId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated() || isAdminSDK();
      allow update: if isAuthenticated() || isAdminSDK();
      allow delete: if isAuthenticated() || isAdminSDK();
    }
    
    // ============================================
    // 체크인
    // ============================================
    match /user_checkin/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && isOwner(userId);
    }
    
    // ============================================
    // 게임 데이터
    // ============================================
    match /user_games/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
    }
    
    // ============================================
    // 랭킹
    // ============================================
    match /rankings/{rankingId} {
      allow read: if true;
      allow write: if isAdminSDK();
    }
    
    // ============================================
    // 신고
    // ============================================
    match /reports/{reportId} {
      allow read: if isAdmin() || isAdminSDK();
      allow create: if isAuthenticated() || isAdminSDK();
      allow update, delete: if isAdmin() || isAdminSDK();
    }
    
    // ============================================
    // 생성된 문서
    // ============================================
    match /generated_documents/{docId} {
      allow read: if isAuthenticated() || isAdminSDK();
      allow create: if isAuthenticated() || isAdminSDK();
      allow update: if false;
      allow delete: if isAuthenticated() || isAdminSDK();
    }
    
    // ============================================
    // 인증 정보
    // ============================================
    match /verifications/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAdminSDK();
    }
    
    // ============================================
    // 상점
    // ============================================
    match /shopItems/{itemId} {
      allow read: if true;
      allow write: if isAdminSDK();
    }
    
    // ============================================
    // 구매 내역
    // ============================================
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() || isAdminSDK();
      allow create: if isAuthenticated() || isAdminSDK();
      allow update, delete: if false;
    }
    
    // ============================================
    // 공지사항
    // ============================================
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin() || isAdminSDK();
    }
    
    // ============================================
    // 중고장터
    // ============================================
    match /marketplace/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdminSDK();
      allow update: if isAuthenticated() || isAdminSDK();
      allow delete: if isAuthenticated() || isAdminSDK();
    }
  }
}

